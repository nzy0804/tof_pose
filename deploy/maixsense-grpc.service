cat >/etc/systemd/system/maixsense-grpc-server.service <<'EOF'
[Unit]
Description=MaixSense gRPC Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/iot_platform/bin

ExecStart=/home/iot_platform/bin/maixsense-grpc-server --host 0.0.0.0 --port 50052 --max-workers 4 --max-msg-mb 50

Restart=always
RestartSec=10
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
EOF
